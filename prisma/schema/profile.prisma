model Profile {
  id String @id @default(uuid())

  // Link to user
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Profile information
  name                 String
  username             String    @unique
  title                String?
  bio                  String?   @db.Text // User bio/description
  avatarUrl            String? // Profile picture URL
  coverUrl             String? // Cover photo URL
  location             String?
  balance              Float     @default(0.0)
  isToggleNotification Boolean   @default(true)
  // Volunteer / mentor opt-in — independent of Cap; gates mentoring tools & verified-hour logging
  isVolunteerMentorOptIn Boolean @default(false)
  /// Illustrated cap art style (structured vs soft rendering)
  capArtStyle            CapArtStyle     @default(STRUCTURED)
  /// Cap placement on profile avatar area; default beside for inclusivity
  capArtPlacement        CapArtPlacement @default(BESIDE)
  /// Free-text when user selects the “Other” interest (app-wide Other pattern)
  interestOtherText      String?  @db.Text
  // personal information
  dateOfBirth          DateTime?
  gender               Gender    @default(MALE)
  experience           String?

  // Social metrics (denormalized for performance)
  followersCount Int @default(0)
  followingCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
  @@index([name])
  @@map("profiles")
}
