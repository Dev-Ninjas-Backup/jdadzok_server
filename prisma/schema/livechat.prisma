// ---------------------------------------------------------------
// 1. ENUMS
// ---------------------------------------------------------------
enum LiveChatType {
  INDIVIDUAL
  GROUP
}

/// Inbox context — General (mutual Connect) vs Mentorship (verified pairing).
enum LiveChatContext {
  GENERAL
  MENTORSHIP
  SUPPORT
}

enum LiveMessageStatus {
  SENT
  DELIVERED
  READ
}

enum LiveMediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

// ---------------------------------------------------------------
// 2. CHAT (your "LiveChat")
// ---------------------------------------------------------------
model LiveChat {
  id        String          @id @default(uuid())
  type      LiveChatType    @default(INDIVIDUAL)
  context   LiveChatContext @default(GENERAL)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Who created the chat (optional)
  createdBy   User?   @relation("LiveChatCreator", fields: [createdById], references: [id])
  createdById String?

  /// Linked volunteer application when thread opened on NGO accept.
  volunteerApplicationId String?              @unique
  volunteerApplication   VolunteerApplication? @relation(fields: [volunteerApplicationId], references: [id], onDelete: SetNull)

  /// Linked Bridge booking when thread opened on provider accept.
  bridgeBookingId String?        @unique
  bridgeBooking   BridgeBooking? @relation(fields: [bridgeBookingId], references: [id], onDelete: SetNull)

  // Relations
  participants LiveChatParticipant[]
  messages     LiveMessage[]
  messageReads LiveMessageRead[]

  @@index([createdById])
  @@index([type])
  @@index([context])
  @@map("live_chats")
}

// ---------------------------------------------------------------
// 3. PARTICIPANT – **with real PK** (your new model)
// ---------------------------------------------------------------
model LiveChatParticipant {
  id String @id @default(uuid())

  // Chat this participant belongs to
  chatId String
  chat   LiveChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // User participating in chat
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime  @default(now())
  leftAt   DateTime? // null = still active

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One user per chat only
  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@map("chat_participants")
}

// ---------------------------------------------------------------
// 4. MESSAGE
// ---------------------------------------------------------------
model LiveMessage {
  id String @id @default(uuid())

  chatId String
  chat   LiveChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content   String?        @db.Text
  mediaUrl  String?
  mediaType LiveMediaType?

  /// Client-generated id for idempotent mobile retries (unique per chat+sender when set).
  clientMessageId String?

  status LiveMessageStatus @default(SENT)

  readBy LiveMessageRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId])
  @@index([senderId])
  @@index([createdAt])
  @@index([chatId, senderId, clientMessageId])
  @@map("live_messages")
}

// ---------------------------------------------------------------
// 5. READ RECEIPT (optional chat reference)
// ---------------------------------------------------------------
model LiveMessageRead {
  id String @id @default(uuid())

  messageId String
  message   LiveMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  // Optional link back to chat (helps queries)
  liveChat   LiveChat? @relation(fields: [liveChatId], references: [id])
  liveChatId String?

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@index([liveChatId])
  @@map("live_message_reads")
}
