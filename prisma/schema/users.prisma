model User {
  id String @id @default(uuid())

  // Authentication fields
  email        String       @unique
  password     String?
  authProvider AuthProvider @default(EMAIL)
  isVerified   Boolean      @default(false)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?

  // User role and progression
  role      Role     @default(USER)
  capLevel  CapLevel @default(NONE)
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- ONE-TO-ONE RELATIONSHIPS ----
  profile Profile?
  about   About?
  metrics UserMetrics? @relation("UserMetrics")

  // ---- ONE-TO-MANY RELATIONSHIPS ----
  posts    Post[]
  comments Comment[]
  likes    Like[]
  shares   Share[]

  // Chat system
  messages        LiveMessage[]
  chatParticipant LiveChatParticipant[]
  createdChats    LiveChat[]            @relation("LiveChatCreator")
  messageReads    LiveMessageRead[]
  // Call system
  // Calling relations
  hostedCalls   Calling[] @relation("HostedCalls")
  receivedCalls Calling[] @relation("ReceivedCalls") // ← ADD THIS
  // Marketplace
  products Product[]
  orders   Order[]    @relation("UserOrders")
  wishlist Wishlist[]

  stripeAccountId  String?
  stripeCustomerId String?
  sellerEarnings   SellerEarnings?

  // Volunteer system
  volunteerApps     VolunteerApplication[]
  volunteerProjects VolunteerProject[]

  // Community/NGO ownership
  ownedCommunities Community[]
  ownedNgos        Ngo[]

  // Monetization
  payouts                 Payout[]
  adRevenueShares         AdRevenueShare[]
  revenues                Revenue[]
  creatorSubscriptions    Subscription[]   @relation("CreatorSubscriptions")
  subscriberSubscriptions Subscription[]   @relation("SubscriberSubscriptions")

  // Moderation
  notifications         Notification[]
  bans                  Ban[]
  reports               Report[]          @relation("ReportsMade")
  reviewedReports       Report[]          @relation("ReportReviewer")
  reviewedVerifications NgoVerification[] @relation("VerificationReviewer")
  issuedBans            Ban[]             @relation("BanIssuer")

  // File uploads
  uploadedFiles FileInstance[] @relation("UploadedFiles")

  // ---- MANY-TO-MANY RELATIONSHIPS ----
  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  // Community interactions
  communityMemberships CommunitiesMembership[]
  likedCommunities     Community[]             @relation("CommunityLikers")

  // NGO interactions
  followedNgos Ngo[] @relation("NgoFollowers")
  likedNgos    Ngo[] @relation("NgoLikers")

  // Post tags
  taggedInPosts PostTagUser[]

  // Endorsements
  givenEndorsements    Endorsement[] @relation("Endorser")
  receivedEndorsements Endorsement[] @relation("Endorsee")

  // User choices
  userChoices UserChoice[]

  corporateContacts CorporateMembership[] @relation("CorporateContact")

  CommunityFollower CommunityFollower[]

  // payment methods -> a user can has multiple payment methods
  PaymentMethods       PaymentMethods[]
  NotificationToggle   NotificationToggle[]
  userNotifications    UserNotification[]
  VolunteerCompletion  VolunteerCompletion[]
  VolunteerHour              VolunteerHour[]
  endorsedVolunteerHours     VolunteerHour[]        @relation("VolunteerHourEndorser")
  counterpartyVolunteerHours VolunteerHour[]        @relation("VolunteerHourCounterparty")
  VolunteerApplication       VolunteerApplication[] @relation("ConfirmedByNgo")

 
  // activityScores ActivityScore[]

  // ----------donation relation -----------`
  withdraws Withdraw[]

  sentRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedRequests FriendRequest[] @relation("FriendRequestReceiver")

  savedPosts SavedPost[]

    // For donor role
  donationsMade DonationLog[] @relation("DonationDonor")

  // For NGO owner receiving donations
  donationsReceived DonationLog[] @relation("DonationReceiver")

  // Sky Blue invitation track
  skyBlueNominationsReceived SkyBlueNomination[] @relation("SkyBlueNominee")
  skyBlueNominationsMade     SkyBlueNomination[] @relation("SkyBlueNominator")

  capPromotionAuditsReceived CapPromotionAudit[] @relation("CapPromotionSubject")
  capPromotionAuditsPerformed  CapPromotionAudit[] @relation("CapPromotionActor")

  // The Bridge (skills / gigs — not goods marketplace)
  bridgeListingsOwned    BridgeListing[] @relation("BridgeListingOwner")
  bridgeBookingsAsClient BridgeBooking[] @relation("BridgeBookingClient")
  bridgeBookingsAsProvider BridgeBooking[] @relation("BridgeBookingProvider")
  talentCandidateUnlocks TalentCandidateUnlock[] @relation("TalentCandidateUnlocks")

  trainingCoursesInstructed TrainingCourse[] @relation("TrainingCourseInstructor")
  trainingEnrollments       TrainingEnrollment[] @relation("TrainingEnrollmentStudent")

  impactDataExportLogs ImpactDataExportLog[] @relation("ImpactExportRequester")

  // Account-fraud vendor checks (Sift / SEON / Castle — optional P3)
  fraudChecks FraudCheck[]

  deviceTokens DeviceToken[]

  @@index([email])
  @@index([capLevel])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}
