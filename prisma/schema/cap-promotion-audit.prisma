enum CapPromotionAction {
  AUTO_PROMOTED
  ADMIN_PROMOTED
  ADMIN_OVERRIDE
  ADMIN_REJECTED
}

model CapPromotionAudit {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("CapPromotionSubject", fields: [userId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("CapPromotionActor", fields: [actorId], references: [id], onDelete: SetNull)

  fromLevel CapLevel
  toLevel   CapLevel
  action    CapPromotionAction

  bypassVerification Boolean @default(false)
  bypassReason       String? @db.Text
  reviewNotes        String? @db.Text

  volunteerHoursAtPromotion Int?
  activityScoreAtPromotion  Float?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([toLevel])
  @@index([actorId])
  @@index([createdAt])
  @@map("cap_promotion_audits")
}
