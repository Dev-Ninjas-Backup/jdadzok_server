model CorporateMembership {
  id String @id @default(uuid())

  // Company information
  companyName  String
  contactEmail String @unique

  // Membership tier (June 26 landings: Starter / Growth / Enterprise)
  tier MembershipTier @default(STARTER)

  // Membership details
  isActive  Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime? // When membership expires

  // Benefits tracking (operational usage)
  dailyAdsUsed     Int @default(0)
  sponsorshipsUsed Int @default(0)

  // SDG alignment — UN Sustainable Development Goals (1–17)
  sdgAlignmentGoals Int[]   @default([])
  sdgImpactSummary  String? @db.Text

  // ESG reporting (CSR dashboard)
  esgReportPeriod            String?
  esgReportUrl               String?
  reportedVolunteerHours     Float     @default(0)
  reportedCommunityInvestment Float    @default(0)
  reportedCarbonOffsetTonnes Float?
  lastEsgReportSubmittedAt   DateTime?

  // Contact person
  contactPersonId String?
  contactPerson   User?   @relation("CorporateContact", fields: [contactPersonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier])
  @@index([isActive])
  @@index([contactEmail])
  @@map("corporate_memberships")
}
