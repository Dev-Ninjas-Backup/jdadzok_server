ABUSE_FRAUD_QUEUE_SCORE=60
ABUSE_FRAUD_REJECT_SCORE=85
# When true, REJECT blocks Stripe onboarding / withdraw; when false, only queue for admin
ABUSE_FRAUD_AUTO_REJECT=true
# When true, vendor API outage fails closed (treat as high risk); default fail-open
