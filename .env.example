ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_MEMBERS=members
ALGOLIA_INDEX_OPPORTUNITIES=opportunities

# Account fraud vendor — P3 optional (plug-in only — no custom ML)
# Values: off | sift | seon | castle | memory (memory = local/CI stand-in)
# Recommended when payout abuse appears: seon (swap sift/castle if client prefers)
ABUSE_FRAUD_PROVIDER=off
ABUSE_FRAUD_QUEUE_SCORE=60
ABUSE_FRAUD_REJECT_SCORE=85
# When true, REJECT blocks Stripe onboarding / withdraw; when false, only queue for admin
ABUSE_FRAUD_AUTO_REJECT=true
# When true, vendor API outage fails closed (treat as high risk); default fail-open
ABUSE_FRAUD_FAIL_CLOSED=false

# Abuse P0 (Issue #25): off-the-shelf vendors only, all default off until client keys arrive
# Signup bot challenge: off | turnstile | memory (the app must then send captchaToken on /users/register)
ABUSE_BOT_PROVIDER=off
TURNSTILE_SECRET_KEY=
ABUSE_BOT_FAIL_CLOSED=false
# Signup email quality (disposable / undeliverable): off | abstract | kickbox | memory
ABUSE_EMAIL_PROVIDER=off
ABSTRACT_EMAIL_API_KEY=
KICKBOX_API_KEY=
ABUSE_EMAIL_FAIL_CLOSED=false
# Post content moderation: off | openai | memory
ABUSE_CONTENT_PROVIDER=off
OPENAI_API_KEY=
# Score >= QUEUE holds the post for admin review, >= REJECT blocks it (0-100)
ABUSE_CONTENT_QUEUE_SCORE=60
ABUSE_CONTENT_REJECT_SCORE=85
ABUSE_CONTENT_AUTO_REJECT=true
# true = vendor outage holds posts for review instead of allowing them
ABUSE_CONTENT_FAIL_CLOSED=false

# Sift
SIFT_API_KEY=
# SIFT_API_BASE=https://api.sift.com/v205

# SEON
SEON_API_KEY=
# SEON_API_BASE=https://api.us.seon.io/SeonRestService

# Castle
CASTLE_API_SECRET=
# CASTLE_API_BASE=https://api.castle.io/v1

# Firebase Admin (social auth + push) — project: jdadzok-ce15c
# Option A: full service account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: individual fields
FIREBASE_PROJECT_ID=jdadzok-ce15c
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (use sk_test_ / whsec_ on production until go-live)
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Minimum amount (USD) a user can request per withdraw (default 100)
WITHDRAW_MIN_AMOUNT=100

# Submission rate limits, per member (placeholders until the client sends final figures).
# Each rule: max submissions per window. Leave blank to use the default shown.
RATE_LIMIT_ENABLED=true
# true = if Redis is unavailable, reject submissions (503) instead of allowing them
RATE_LIMIT_FAIL_CLOSED=false
# Posts: 20 per hour
RATE_LIMIT_POST_MAX=20
RATE_LIMIT_POST_WINDOW_SECONDS=3600
# Comments and replies: 60 per hour
RATE_LIMIT_COMMENT_MAX=60
RATE_LIMIT_COMMENT_WINDOW_SECONDS=3600
# Endorsing volunteer hours: 10 per day
RATE_LIMIT_ENDORSEMENT_MAX=10
RATE_LIMIT_ENDORSEMENT_WINDOW_SECONDS=86400
# Logging volunteer hours: 20 per day
RATE_LIMIT_HOUR_LOG_MAX=20
RATE_LIMIT_HOUR_LOG_WINDOW_SECONDS=86400

# Optional: email of the user who receives support chats (defaults to first ADMIN)
SUPPORT_AGENT_EMAIL=

# Calls — ICE servers (Issue #40)
# STUN only discovers each peer's public address, so calls connect only when both
# sides are directly reachable. On cellular/CGNAT they are not, and the call hangs
# on "Connecting…". TURN relays the media in that case. Leave the TURN_* vars empty
# to keep the previous STUN-only behaviour. Setup: docs/TURN_SETUP.md
# Optional: override the STUN pool (comma-separated)
#STUN_URL=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# coturn URLs. Include a TCP entry — UDP is blocked on many corporate/mobile nets.
TURN_URL=
# Preferred: shared secret from coturn's `use-auth-secret`. The server mints a
# short-lived credential per call; the secret itself never leaves the VPS.
TURN_SECRET=
# Fallback for a TURN server without REST auth (sent to clients as-is)
TURN_USERNAME=
TURN_PASSWORD=
# Lifetime of a minted credential, in seconds (default 14400 = 4h)
#TURN_TTL_SECONDS=14400
# Must match coturn's `realm`
#TURN_REALM=synqulan.com
# Host/IP coturn advertises, for a NAT'd VPS (see docs/TURN_SETUP.md)
#TURN_EXTERNAL_IP=
